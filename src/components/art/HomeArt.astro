---
// Line-drawn floor plan with the sun passing over it.
---

<div class="h-art" aria-hidden="true">
  <svg viewBox="0 0 600 420" preserveAspectRatio="xMidYMid meet">
    <g class="sky">
      <path class="arc" d="M110 196 A190 160 0 0 1 490 196" />
      <g class="sun-orbit">
        <circle class="sun" cx="110" cy="196" r="14" />
      </g>
    </g>
    <path class="light" d="M250 212 L330 212 L372 356 L214 356 Z" />
    <g class="plan">
      <rect x="140" y="212" width="320" height="170" rx="4" class="wall" />
      <path d="M300 212 V300 M300 336 V382" class="wall" />
      <path d="M140 300 H232 M268 300 H300" class="wall" />
      <path d="M380 212 V270 M380 306 V382" class="thin" />
      <path d="M232 300 A36 36 0 0 1 268 300" class="door" />
      <path d="M380 270 A36 36 0 0 1 416 306" class="door" />
      <path d="M250 212 H330" class="window" />
      <path d="M460 250 V320" class="window" />
    </g>
    <g class="tags">
      <text x="168" y="266">Bedroom</text>
      <text x="326" y="356">Living</text>
    </g>
  </svg>
</div>

<style>
  .h-art {
    --sun: #e2a93b;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 6% 8% 4%;
    background:
      radial-gradient(90% 70% at 50% 10%, color-mix(in srgb, var(--sun) 16%, transparent), transparent 70%),
      var(--surface-2);
  }
  svg {
    width: 100%;
    height: 100%;
    max-width: 520px;
  }
  .arc {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }
  /* Rotate the sun around the arc's center so it travels along the dashed path. */
  .sun-orbit {
    transform-origin: 300px 196px;
    transform: rotate(0deg);
    transition: transform 2400ms var(--ease-in-out) 300ms;
  }
  :global(.is-in) .sun-orbit {
    transform: rotate(118deg);
  }
  .sun {
    fill: var(--sun);
  }
  .light {
    fill: color-mix(in srgb, var(--sun) 22%, transparent);
    opacity: 0;
    transition: opacity 1200ms var(--ease-out) 1400ms;
  }
  :global(.is-in) .light {
    opacity: 1;
  }
  .wall {
    fill: none;
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linecap: round;
  }
  rect.wall {
    fill: var(--surface);
  }
  .thin {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .door {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .window {
    stroke: var(--accent);
    stroke-width: 8;
    stroke-linecap: round;
  }
  .tags text {
    font: 500 15px var(--font);
    fill: var(--muted);
  }
</style>
