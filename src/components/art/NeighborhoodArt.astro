---
// Abstract map: neighborhood boundaries over a street grid, one selected.
// Deliberately not a product screenshot. No real places, prices, or UI.
const V = {
  A: [140, 120], B: [420, 90], C: [700, 130], D: [960, 100], E: [1080, 260],
  F: [160, 360], G: [400, 330], H: [640, 380], I: [880, 340], J: [1070, 480],
  K: [180, 620], L: [430, 650], M: [690, 610], N: [940, 640],
} as const;
type Key = keyof typeof V;
const poly = (...keys: Key[]) => 'M' + keys.map((k) => V[k].join(' ')).join(' L') + ' Z';

const hoods = [
  poly('A', 'B', 'G', 'F'),
  poly('C', 'D', 'E', 'I', 'H'),
  poly('F', 'G', 'L', 'K'),
  poly('G', 'H', 'M', 'L'),
  poly('H', 'I', 'J', 'N', 'M'),
];
const selected = poly('B', 'C', 'H', 'G');
const pins = [
  [505, 190], [612, 176], [468, 276], [588, 262], [548, 332],
];
const streetsH = Array.from({ length: 9 }, (_, i) => 20 + i * 92);
const streetsV = Array.from({ length: 12 }, (_, i) => 40 + i * 108);
---

<div class="n-art">
  <svg class="map" viewBox="0 0 1200 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect class="land" width="1200" height="720" />
    <path class="water" d="M1200 520 C1090 540 1010 610 985 720 L1200 720 Z" />
    <path class="park" d="M232 452 q64 -34 116 8 q24 62 -38 94 q-74 12 -78 -40 z" />
    <path class="park" d="M760 452 q40 -22 84 0 q14 40 -30 58 q-58 6 -54 -58 z" />
    <g class="streets">
      {streetsH.map((y) => <path d={`M0 ${y} L1200 ${y + 36}`} />)}
      {streetsV.map((x) => <path d={`M${x} 0 L${x - 44} 720`} />)}
    </g>
    <g class="arterials">
      <path d="M-20 520 C300 470 520 560 760 500 S1100 420 1220 452" />
      <path d="M300 -20 C332 200 282 420 362 740" />
    </g>
    <g class="hoods">
      {hoods.map((d) => <path class="hood" d={d} />)}
    </g>
    <path class="selected-fill" d={selected} />
    <path class="selected" d={selected} pathLength="1" />
    <g class="pins">
      {pins.map(([x, y], i) => (
        <g class="pin" style={`--p: ${i}`}>
          <circle cx={x} cy={y} r="13" class="pin-halo" />
          <circle cx={x} cy={y} r="7" class="pin-dot" />
        </g>
      ))}
    </g>
    <g class="chip" transform="translate(452 424)">
      <rect x="0" y="-22" width="188" height="44" rx="22" />
      <circle cx="24" cy="0" r="6" class="chip-dot" />
      <text x="40" y="6">This neighborhood</text>
    </g>
  </svg>

  <div class="search" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.75" stroke="currentColor" stroke-width="1.5" /><path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    <span>Search by neighborhood</span><span class="caret"></span>
  </div>

  <div class="results" aria-hidden="true">
    {[0, 1, 2].map((i) => (
      <div class="row" style={`--r: ${i}`}>
        <span class="thumb"></span>
        <span class="lines"><span></span><span></span></span>
      </div>
    ))}
  </div>
</div>

<style>
  .n-art {
    --land: #e9e7df;
    --street: rgba(22, 22, 20, 0.07);
    --arterial: #f7f6f2;
    --water: #d5e0e3;
    --park: #d6e3d4;
    position: absolute;
    inset: 0;
    background: var(--land);
    overflow: hidden;
  }
  @media (prefers-color-scheme: dark) {
    .n-art {
      --land: #1f1f1c;
      --street: rgba(236, 234, 228, 0.06);
      --arterial: #2a2a26;
      --water: #1e2a2d;
      --park: #1f2b22;
    }
  }
  .map {
    width: 100%;
    height: 100%;
  }
  .land {
    fill: var(--land);
  }
  .water {
    fill: var(--water);
  }
  .park {
    fill: var(--park);
  }
  .streets path {
    stroke: var(--street);
    stroke-width: 2;
    fill: none;
  }
  .arterials path {
    stroke: var(--arterial);
    stroke-width: 12;
    stroke-linecap: round;
    fill: none;
  }
  .hood {
    fill: transparent;
    stroke: var(--line-strong);
    stroke-width: 2;
    stroke-dasharray: 8 8;
    transition: fill 240ms var(--ease-out);
  }
  @media (hover: hover) {
    .hood:hover {
      fill: rgba(22, 22, 20, 0.04);
    }
  }
  .selected-fill {
    fill: var(--accent-soft);
    opacity: 0;
    transition: opacity 800ms var(--ease-out) 700ms;
  }
  .selected {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1400ms var(--ease-in-out) 200ms;
  }
  .pin {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(1100ms + var(--p) * 90ms);
  }
  .pin-halo {
    fill: var(--surface);
  }
  .pin-dot {
    fill: var(--accent);
  }
  .chip {
    opacity: 0;
    transition: opacity 500ms var(--ease-out) 1500ms;
  }
  .chip rect {
    fill: var(--surface);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.12));
  }
  .chip-dot {
    fill: var(--accent);
  }
  .chip text {
    font: 500 19px var(--font);
    fill: var(--ink);
    letter-spacing: -0.01em;
  }

  /* Revealed state, keyed off the parent frame's .is-in */
  :global(.is-in) .selected {
    stroke-dashoffset: 0;
  }
  :global(.is-in) .selected-fill,
  :global(.is-in) .chip {
    opacity: 1;
  }
  :global(.is-in) .pin {
    transform: scale(1);
  }

  .search {
    position: absolute;
    top: clamp(14px, 4%, 28px);
    left: clamp(14px, 3%, 28px);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 12px 14px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: clamp(13px, 1.2vw, 16px);
    color: var(--ink-2);
  }
  .search svg {
    width: 16px;
    height: 16px;
    color: var(--muted);
  }
  .caret {
    width: 1.5px;
    height: 1.1em;
    margin-left: -6px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .results {
    position: absolute;
    right: clamp(14px, 3%, 28px);
    bottom: clamp(14px, 4%, 28px);
    width: min(36%, 300px);
    padding: 10px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    display: grid;
    gap: 8px;
  }
  .row {
    display: flex;
    gap: 10px;
    align-items: center;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 500ms var(--ease-out),
      transform 600ms var(--ease-out);
    transition-delay: calc(1500ms + var(--r) * 110ms);
  }
  :global(.is-in) .row {
    opacity: 1;
    transform: none;
  }
  .thumb {
    width: 44px;
    height: 34px;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--accent-soft), var(--surface-2));
    flex-shrink: 0;
  }
  .lines {
    flex: 1;
    display: grid;
    gap: 6px;
  }
  .lines span {
    height: 7px;
    border-radius: 9px;
    background: var(--surface-2);
  }
  .lines span:first-child {
    width: 80%;
    background: var(--line-strong);
  }
  .lines span:last-child {
    width: 55%;
  }

  @media (max-width: 720px) {
    .results {
      display: none;
    }
  }
</style>
