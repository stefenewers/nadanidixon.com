---
import { site } from '../data/site';
import Arrow from './Arrow.astro';
---

<header class="intro">
  <img class="portrait" src="/nadani.jpg" alt="Portrait of Nadani Dixon, smiling, in a dark sweater" width="480" height="480" decoding="async" fetchpriority="high" />
  <h1 class="lead">
    <span class="name">{site.name}</span>
    <span class="desc">Software engineer in Atlanta, building the parts of a product people actually touch.</span>
  </h1>
  <p class="about">
    Search boxes, listing pages, the email that brings you back. Right now that’s rental search at Redfin, and
    alongside it I’m working toward an M.S. in Computer Science at Georgia Tech.
  </p>
  <p class="links">
    <a class="link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<Arrow /></a>
  </p>
</header>

<style>
  .intro {
    padding-top: clamp(48px, 9vh, 104px);
  }
  .portrait {
    display: block;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .lead {
    margin-top: 28px;
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 1.875rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .name {
    display: block;
    color: var(--ink);
  }
  .desc {
    display: block;
    color: var(--muted);
  }
  .about {
    margin-top: 20px;
    max-width: 34em;
    color: var(--ink-2);
  }
  .links {
    margin-top: 20px;
    font-size: 15px;
    font-weight: 500;
  }
</style>
