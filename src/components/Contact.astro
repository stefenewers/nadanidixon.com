---
import { site } from '../data/site';
import Arrow from './Arrow.astro';
---

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <div class="panel" data-reveal>
    <p class="eyebrow">Get in touch</p>
    <h2 id="contact-title" class="big">
      I’m always up for a conversation about product engineering, or about what your team is building.
    </h2>
    <div class="actions">
      <a class="btn primary" href={site.linkedin} target="_blank" rel="noopener noreferrer">
        Connect on LinkedIn <Arrow />
      </a>
      {
        site.resume && (
          <a class="btn" href={site.resume}>
            Download résumé <Arrow />
          </a>
        )
      }
      {
        site.email && (
          <a class="btn" href={`mailto:${site.email}`}>
            Email me <Arrow />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding-top: clamp(96px, 14vw, 180px);
  }
  .panel {
    padding: clamp(32px, 6vw, 80px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--ink);
    color: var(--bg);
  }
  .panel .eyebrow {
    color: color-mix(in srgb, var(--bg) 60%, transparent);
  }
  .big {
    margin-top: 20px;
    max-width: 18em;
    font-size: clamp(1.9rem, 1rem + 3.2vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .actions {
    margin-top: clamp(32px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--bg) 25%, transparent);
    font-weight: 500;
    transition:
      transform 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }
  .btn :global(svg) {
    width: 12px;
    height: 12px;
    transition: transform 220ms var(--ease-out);
  }
  .primary {
    background: var(--bg);
    color: var(--ink);
    border-color: transparent;
  }
  @media (hover: hover) {
    .btn:hover :global(svg) {
      transform: translate(2px, -2px);
    }
    .btn:not(.primary):hover {
      background: color-mix(in srgb, var(--bg) 10%, transparent);
    }
  }
  .btn:active {
    transform: scale(0.98);
  }
</style>
