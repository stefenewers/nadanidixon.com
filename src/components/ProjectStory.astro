---
// Page for a project outside of work (starting with Thinketh). Same bones as a
// work page, plus real product screens and a demo video.
import Base from '../layouts/Base.astro';
import TopBar from './TopBar.astro';
import Footer from './Footer.astro';
import Visual from './Visual.astro';
import Mark from './Mark.astro';
import WorkPager from './WorkPager.astro';
import Arrow from './Arrow.astro';
import Phone from './Phone.astro';
import { projects, projectStories, type Shot } from '../data/work';
import { pageAnim } from '../lib/transitions';

interface Props {
  id: keyof typeof projectStories;
}
const project = projects.find((p) => p.id === Astro.props.id)!;
const story = projectStories[Astro.props.id];
---

<Base title={project.name} description={`${story.headline} ${story.intro}`}>
  <TopBar mid />
  <main id="main" class="page page--mid story" transition:animate={pageAnim}>
    <header class="head">
      <Mark mark={project.mark} logo={project.logo} strong name={`mark-${project.id}`} />
      <div>
        <h1 tabindex="-1" data-focus-on-nav>
          <span class="company" transition:name={`company-${project.id}`}>{project.name}</span>
        </h1>
        <p class="role">{story.dates}</p>
      </div>
    </header>
    <p class="headline">{story.headline}</p>
    <p class="intro">{story.intro}</p>

    <Visual art={story.art} class="hero" name={`art-${project.id}`} />

    <section class="block" aria-labelledby="idea-label">
      <h2 id="idea-label" class="label">The idea</h2>
      <p class="idea-text">{story.idea}</p>
    </section>

    <section class="shots-block" aria-labelledby="product-label">
      <h2 id="product-label" class="label">The product</h2>
      <div class="shots shots--3">
        {story.product.map((shot: Shot) => <Phone shot={shot} />)}
      </div>
    </section>

    <section class="block" aria-labelledby="demo-label">
      <h2 id="demo-label" class="label">Demo</h2>
      <div class="video">
        <iframe
          src={story.video.src}
          title={story.video.title}
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
    </section>

    <section class="block" aria-labelledby="mine-label">
      <h2 id="mine-label" class="label">What I built</h2>
      <div>
        <ul class="list">
          {story.mine.map((w) => <li>{w}</li>)}
        </ul>
        <p class="closing">{story.team}</p>
        <div class="shots shots--2">
          {story.built.map((shot: Shot) => <Phone shot={shot} />)}
        </div>
      </div>
    </section>

    <dl class="meta">
      {
        story.meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="links">
      {
        story.links.map((l) => (
          <a class="link" href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}
            <Arrow />
          </a>
        ))
      }
    </p>

    <WorkPager current={project.id} />
  </main>
  <Footer mid />
</Base>

<style>
  .story {
    padding-top: clamp(40px, 8vh, 88px);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .head :global(.mark) {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    font-size: 18px;
  }
  h1 {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .company {
    display: inline-block;
  }
  .role {
    color: var(--muted);
    font-size: 15px;
  }
  .headline {
    margin-top: 28px;
    max-width: 24em;
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.625rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .intro {
    margin-top: 14px;
    max-width: 36em;
    color: var(--ink-2);
  }
  .story :global(.hero) {
    margin-top: clamp(36px, 5vh, 56px);
    aspect-ratio: 16 / 9.4;
  }
  .block {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 11em minmax(0, 1fr);
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .block:first-of-type {
    border-top: 0;
  }
  .label {
    padding-top: 2px;
  }
  .idea-text {
    max-width: 30em;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.012em;
  }
  .shots-block {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .shots {
    display: grid;
    gap: clamp(20px, 3vw, 36px);
    margin-top: 20px;
    align-items: start;
  }
  .shots--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .shots--2 {
    grid-template-columns: repeat(2, minmax(0, 280px));
    margin-top: 32px;
  }
  .video {
    position: relative;
    aspect-ratio: 4 / 3;
    max-width: 720px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .list {
    list-style: none;
    display: grid;
    gap: 12px;
    max-width: 36em;
  }
  .list li {
    position: relative;
    padding-left: 18px;
    color: var(--ink-2);
  }
  .list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1.5px;
    background: var(--muted);
  }
  .closing {
    margin-top: 20px;
    max-width: 36em;
    color: var(--muted);
  }
  .meta {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    font-size: 14px;
  }
  .meta dt {
    color: var(--muted);
  }
  .links {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: 15px;
    font-weight: 500;
  }
  @media (max-width: 720px) {
    .block {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .shots--3 {
      grid-template-columns: repeat(3, 72%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 8px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .shots--3 > :global(*) {
      scroll-snap-align: start;
    }
  }
  @media (max-width: 576px) {
    .story :global(.hero) {
      aspect-ratio: 3 / 5;
    }
    .shots--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }
</style>
