---
// "Next" link at the bottom of each work or project page, cycling through the
// homepage order: roles first, then projects.
import { roles, projects } from '../data/work';
import Arrow from './Arrow.astro';
import Mark from './Mark.astro';

interface Props {
  current: string;
}
const items = [
  ...roles
    .filter((r) => r.href)
    .map((r) => ({ id: r.id, mark: r.mark, logo: r.logo, logoTile: r.logoTile, name: r.company, href: r.href! })),
  ...projects.map((p) => ({ id: p.id, mark: p.mark, logo: p.logo, logoTile: false, name: p.name, href: p.href })),
];
const i = items.findIndex((r) => r.id === Astro.props.current);
const next = items[(i + 1) % items.length];
---

<nav class="pager" aria-label="More work">
  <a class="next" href={next.href}>
    <span class="label">Next</span>
    <span class="row">
      <Mark mark={next.mark} logo={next.logo} logoTile={next.logoTile} />
      <span class="name">{next.name}</span>
      <Arrow dir="right" />
    </span>
  </a>
</nav>

<style>
  .pager {
    margin-top: clamp(64px, 9vh, 104px);
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .next {
    display: inline-grid;
    gap: 8px;
  }
  .row {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
    font-weight: 500;
  }
  .row :global(svg) {
    width: 12px;
    height: 12px;
    transition: transform 220ms var(--ease-out);
  }
  @media (hover: hover) {
    .next:hover :global(svg) {
      transform: translateX(3px);
    }
    .next:hover .name {
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
    }
  }
</style>
