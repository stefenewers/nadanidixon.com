---
import { site } from '../data/site';
import Arrow from './Arrow.astro';

interface Props {
  wide?: boolean;
  mid?: boolean;
}
const { wide = false, mid = false } = Astro.props;
---

<nav class:list={['bar', 'page', { 'page--wide': wide, 'page--mid': mid }]} aria-label="Site">
  <a class="back" href="/"><Arrow dir="left" />All work</a>
  <a class="link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<Arrow /></a>
</nav>

<style>
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    font-size: 14px;
    font-weight: 500;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: -12px;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--ink-2);
    transition: background-color 160ms var(--ease-out);
  }
  .back :global(svg) {
    width: 11px;
    height: 11px;
    transition: transform 220ms var(--ease-out);
  }
  @media (hover: hover) {
    .back:hover {
      background: var(--surface-2);
      color: var(--ink);
    }
    .back:hover :global(svg) {
      transform: translateX(-2px);
    }
  }
</style>
