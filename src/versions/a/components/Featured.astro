---
import { featured } from '../data/work';
import Frame from './Frame.astro';
import Arrow from './Arrow.astro';
---

<section id="featured" class="featured wrap" aria-labelledby="featured-title">
  <p class="eyebrow" data-reveal>Featured project</p>
  <Frame art={featured.art} media={featured.media} class="featured-frame" eager />
  <div class="body">
    <div class="head" data-reveal>
      <h2 id="featured-title" class="title">{featured.title}</h2>
      <p class="lede">{featured.lede}</p>
    </div>
    <div class="detail" data-reveal style="--delay: 120ms">
      {featured.body.map((p) => <p>{p}</p>)}
      <dl class="meta">
        {
          featured.meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
      {
        featured.caseStudy && (
          <a class="link cta" href={`/work/${featured.caseStudy}`}>
            Read the case study
            <Arrow dir="right" />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .featured {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .featured :global(.featured-frame) {
    margin-top: 20px;
    aspect-ratio: 16 / 9;
  }
  .body {
    margin-top: clamp(28px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 6vw, 96px);
  }
  .title {
    font-size: clamp(2.5rem, 1.4rem + 4vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .lede {
    margin-top: 20px;
    max-width: 20em;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink-2);
    text-wrap: balance;
  }
  .detail {
    display: grid;
    gap: 16px;
    align-content: start;
    color: var(--ink-2);
    padding-top: 0.5em;
  }
  .meta {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 8px 36px;
    font-size: 14px;
  }
  .meta dt {
    color: var(--muted);
  }
  .meta dd {
    color: var(--ink);
  }
  .cta {
    margin-top: 8px;
    font-weight: 500;
    color: var(--ink);
  }

  @media (max-width: 1024px) {
    .featured :global(.featured-frame) {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 800px) {
    .body {
      grid-template-columns: 1fr;
    }
    .meta {
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid var(--line);
    }
    .meta div {
      display: grid;
      grid-template-columns: 6.5em 1fr;
      padding: 10px 0;
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .featured :global(.featured-frame) {
      aspect-ratio: 1 / 1;
    }
  }
</style>
