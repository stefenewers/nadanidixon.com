---
// Small arrow glyph. `up` points up-right for external links.
interface Props {
  dir?: 'up' | 'right' | 'left';
}
const { dir = 'up' } = Astro.props;
---

{
  dir === 'up' ? (
    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M3.5 8.5l5-5M4.5 3.5h4v4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  ) : dir === 'right' ? (
    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M2.5 6h7M6.5 3l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  ) : (
    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M9.5 6h-7M5.5 3l-3 3 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
