---
import { work, alsoWork } from '../data/work';
import WorkTile from './WorkTile.astro';
---

<section id="work" class="more wrap" aria-labelledby="more-title">
  <header class="more-head" data-reveal>
    <h2 id="more-title" class="section-title">More from Redfin Rentals</h2>
    <p class="muted">
      Other things I’ve worked on, grouped by the question a renter is asking when they reach them.
    </p>
  </header>

  <div class="grid">
    {work.map((entry, i) => <WorkTile entry={entry} delay={(i % 2) * 100} />)}
  </div>

  <div class="also" data-reveal>
    <p class="also-label">Behind the scenes</p>
    <ul>
      {
        alsoWork.map((f) => (
          <li>
            <span class="a-name">{f.name}</span>
            <span class="a-sum">{f.summary}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .more {
    padding-top: clamp(96px, 14vw, 180px);
  }
  .more-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(16px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .more-head p {
    max-width: 28em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(56px, 7vw, 96px) clamp(20px, 3vw, 40px);
  }
  .also {
    margin-top: clamp(56px, 7vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(12px, 6vw, 96px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .also-label {
    font-size: 14px;
    color: var(--muted);
  }
  .also ul {
    list-style: none;
    display: grid;
    gap: 16px;
  }
  .also li {
    display: grid;
    gap: 4px;
  }
  .a-name {
    font-weight: 500;
  }
  .a-sum {
    color: var(--ink-2);
  }
  @media (max-width: 800px) {
    .more-head,
    .also {
      grid-template-columns: 1fr;
    }
  }
</style>
