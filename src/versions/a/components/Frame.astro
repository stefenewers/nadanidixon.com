---
// Visual slot for a piece of work. Shows a real screenshot when `media` is
// set, and otherwise falls back to the drawn illustration for that entry.
import type { Art, Media } from '../data/work';
import NeighborhoodArt from './art/NeighborhoodArt.astro';
import CostArt from './art/CostArt.astro';
import HomeArt from './art/HomeArt.astro';
import DiscoverArt from './art/DiscoverArt.astro';

interface Props {
  art: Art;
  media?: Media;
  class?: string;
  eager?: boolean;
}

const { art, media, class: className, eager = false } = Astro.props;
const arts = { neighborhood: NeighborhoodArt, cost: CostArt, home: HomeArt, discover: DiscoverArt };
const ArtComponent = arts[art];
---

<figure class:list={['frame', className]} data-reveal>
  {
    media ? (
      <img
        src={media.src}
        alt={media.alt}
        width={media.width}
        height={media.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <>
        <ArtComponent />
        <figcaption class="tag">Illustration</figcaption>
      </>
    )
  }
</figure>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
    isolation: isolate;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .frame::after {
    /* Hairline above the art so edges stay crisp on any background. */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--line);
    pointer-events: none;
    z-index: 2;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tag {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 3;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(6px);
  }
</style>
