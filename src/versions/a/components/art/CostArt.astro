---
// Listed rent vs. the fuller monthly picture. No numbers on purpose.
const extras = [
  { w: 16, cls: 'e1' },
  { w: 11, cls: 'e2' },
  { w: 8, cls: 'e3' },
];
---

<div class="c-art" aria-hidden="true">
  <div class="card">
    <div class="row">
      <span class="label">Listed rent</span>
      <div class="track"><span class="seg rent" style="--w: 58%; --d: 0"></span></div>
    </div>
    <div class="row">
      <span class="label">Total monthly cost</span>
      <div class="track">
        <span class="seg rent" style="--w: 58%; --d: 1"></span>
        {extras.map((e, i) => <span class={`seg ${e.cls}`} style={`--w: ${e.w}%; --d: ${i + 2}`} />)}
      </div>
    </div>
    <div class="legend">
      <span><i class="k rent"></i>Rent</span>
      <span><i class="k e1"></i>Everything else</span>
    </div>
  </div>
</div>

<style>
  .c-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 12% 8%;
    background:
      radial-gradient(120% 90% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--surface-2);
  }
  .card {
    width: 100%;
    max-width: 440px;
    padding: clamp(18px, 4%, 28px);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    display: grid;
    gap: 20px;
  }
  .row {
    display: grid;
    gap: 8px;
  }
  .label {
    font-size: 13px;
    color: var(--muted);
  }
  .track {
    display: flex;
    gap: 3px;
    height: 30px;
  }
  .seg {
    width: 0;
    border-radius: 6px;
    transition: width 900ms var(--ease-out);
    transition-delay: calc(250ms + var(--d) * 140ms);
  }
  :global(.is-in) .seg {
    width: var(--w);
  }
  .rent {
    background: var(--ink);
  }
  .e1 {
    background: var(--accent);
  }
  .e2 {
    background: color-mix(in srgb, var(--accent) 60%, var(--surface));
  }
  .e3 {
    background: color-mix(in srgb, var(--accent) 32%, var(--surface));
  }
  .legend {
    display: flex;
    gap: 18px;
    font-size: 13px;
    color: var(--ink-2);
    padding-top: 4px;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .k {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
</style>
