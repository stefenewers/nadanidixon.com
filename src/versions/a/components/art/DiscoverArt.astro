---
// A small stack of cards, the top one swiping away, plus an email peeking in.
const cards = [2, 1, 0];
---

<div class="d-art" aria-hidden="true">
  <div class="stack">
    {cards.map((i) => (
      <div class={`card c${i}`}>
        <div class="img">
          <svg viewBox="0 0 64 48" fill="none">
            <path d="M14 40V22L32 9l18 13v18" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
            <path d="M27 40V29h10v11" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
          </svg>
        </div>
        <span class="bar b1"></span>
        <span class="bar b2"></span>
      </div>
    ))}
    <div class="actions">
      <span class="btn">
        <svg viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </span>
      <span class="btn like">
        <svg viewBox="0 0 16 16"><path d="M8 13.5S2 10 2 6a3 3 0 0 1 6-1 3 3 0 0 1 6 1c0 4-6 7.5-6 7.5z" fill="currentColor" /></svg>
      </span>
    </div>
  </div>

  <div class="mail">
    <div class="mail-head">
      <svg viewBox="0 0 20 16" fill="none"><rect x="1" y="1" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.6" /><path d="M2 3l8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
      <span class="bar m0"></span>
    </div>
    <span class="bar m1"></span>
    <span class="bar m2"></span>
    <div class="mail-thumbs"><span></span><span></span></div>
  </div>
</div>

<style>
  .d-art {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 7%, 72px);
    padding: 7%;
    background:
      radial-gradient(80% 90% at 0% 100%, var(--accent-soft), transparent 65%),
      var(--surface-2);
  }
  .stack {
    position: relative;
    width: clamp(150px, 34%, 230px);
    aspect-ratio: 3 / 4;
  }
  .card {
    position: absolute;
    inset: 0 0 56px;
    padding: 10px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition:
      transform 900ms var(--ease-out),
      opacity 700ms var(--ease-out);
  }
  .c1 {
    transform: translateY(-10px) scale(0.95);
  }
  .c2 {
    transform: translateY(-20px) scale(0.9);
    opacity: 0.7;
  }
  :global(.is-in) .c0 {
    transform: translateX(62%) rotate(14deg);
    opacity: 0;
    transition-delay: 900ms;
  }
  :global(.is-in) .c1 {
    transform: none;
    transition-delay: 1050ms;
  }
  :global(.is-in) .c2 {
    transform: translateY(-10px) scale(0.95);
    opacity: 1;
    transition-delay: 1150ms;
  }
  .img {
    flex: 1;
    border-radius: 10px;
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: linear-gradient(150deg, var(--accent-soft), var(--surface-2));
  }
  .c1 .img {
    background: linear-gradient(150deg, var(--surface-2), color-mix(in srgb, #e2a93b 18%, var(--surface-2)));
  }
  .img svg {
    width: 38%;
  }
  .bar {
    display: block;
    height: 8px;
    border-radius: 9px;
    background: var(--surface-2);
  }
  .b1 {
    width: 70%;
    background: var(--line-strong);
  }
  .b2 {
    width: 45%;
  }
  .actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    gap: 14px;
  }
  .btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--muted);
  }
  .btn svg {
    width: 15px;
    height: 15px;
  }
  .like {
    color: var(--accent);
  }

  .mail {
    width: clamp(160px, 30%, 250px);
    padding: 16px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow);
    display: grid;
    gap: 10px;
    transform: translateY(18px) rotate(3deg);
    opacity: 0;
    transition:
      transform 900ms var(--ease-out) 400ms,
      opacity 700ms var(--ease-out) 400ms;
  }
  :global(.is-in) .mail {
    transform: rotate(3deg);
    opacity: 1;
  }
  .mail-head {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
  }
  .mail-head svg {
    width: 20px;
    flex-shrink: 0;
  }
  .m0 {
    width: 60%;
    background: var(--line-strong);
  }
  .m1 {
    width: 90%;
  }
  .m2 {
    width: 70%;
  }
  .mail-thumbs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 4px;
  }
  .mail-thumbs span {
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    background: linear-gradient(150deg, var(--accent-soft), var(--surface-2));
  }

  @media (max-width: 520px) {
    .mail {
      display: none;
    }
    .stack {
      width: 52%;
    }
  }
</style>
