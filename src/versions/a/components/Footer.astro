---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot wrap">
  <span>© {year} {site.name}</span>
  <a class="link" href="#main">Back to top</a>
</footer>

<style>
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 40px;
    padding-bottom: 40px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
