---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import WorkIndex from '../components/WorkIndex.astro';
import Education from '../components/Education.astro';
import Stage from '../components/Stage.astro';
import Footer from '../components/Footer.astro';
import { pageAnim } from '../lib/transitions';
---

<Base>
  <main id="main" class="home" transition:animate={pageAnim}>
    <div class="col">
      <Intro />
      <WorkIndex />
      <Education />
    </div>
    <div class="stage-col">
      <Stage />
    </div>
  </main>
  <Footer wide />
</Base>

<style>
  .home {
    width: 100%;
    max-width: calc(760px + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .stage-col {
    display: none;
  }
  @media (min-width: 1024px) {
    .home {
      max-width: calc(1280px + var(--gutter) * 2);
      display: grid;
      grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
      gap: clamp(48px, 6vw, 112px);
      align-items: start;
    }
    .stage-col {
      display: block;
      padding-top: 24px;
      height: 100%;
    }
  }
</style>
