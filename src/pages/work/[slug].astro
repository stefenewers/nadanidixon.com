---
// Case study pages, one per file in src/content/work. Drafts only build in dev.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Footer from '../../components/Footer.astro';
import { pageAnim } from '../../lib/transitions';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <TopBar />
  <main id="main" class="page cs" transition:animate={pageAnim}>
    {entry.data.draft && <p class="draft">Draft. Not published in production builds.</p>}
    <h1 class="title" tabindex="-1" data-focus-on-nav>{entry.data.title}</h1>
    <p class="summary">{entry.data.summary}</p>
    <dl class="meta">
      <div><dt>Team</dt><dd>{entry.data.team}</dd></div>
      <div><dt>Role</dt><dd>{entry.data.role}</dd></div>
    </dl>
    <article class="prose">
      <Content />
    </article>
  </main>
  <Footer />
</Base>

<style>
  .cs {
    padding-top: clamp(40px, 8vw, 96px);
    padding-bottom: 64px;
  }
  .draft {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 13px;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .title {
    margin-top: 24px;
    font-size: clamp(2.5rem, 1.4rem + 4vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .summary {
    margin-top: 20px;
    max-width: 24em;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.3;
    color: var(--ink-2);
  }
  .meta {
    margin-top: 32px;
    display: flex;
    gap: 36px;
    font-size: 14px;
  }
  .meta dt {
    color: var(--muted);
  }
  .prose {
    margin-top: clamp(48px, 7vw, 88px);
    max-width: 40em;
    color: var(--ink-2);
  }
  .prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(img) {
    margin: 32px 0;
    border-radius: var(--radius);
  }
  .prose :global(blockquote) {
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-size: 15px;
  }
</style>
